# Copy to .env and change the values. NEVER commit .env.
DB_NAME=smartcart
DB_USERNAME=smartcart
DB_PASSWORD=change-me

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# First admin account, created on startup if it does not exist
ADMIN_EMAIL=admin@smartcart.local
ADMIN_PASSWORD=change-me-admin

SEED_DEMO_DATA=true

# Optional email notifications (disabled by default; notifications are always logged)
NOTIFICATION_EMAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# Running the backend outside Docker (mvn spring-boot:run) can also use:
# DB_URL=jdbc:postgresql://localhost:5432/smartcart
# REDIS_HOST=localhost
# REDIS_PORT=6379
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
